# Coti — plantilla de variables de entorno
#
# Copiá este archivo a `.env.local` y llená los valores. NUNCA pongas valores
# reales aquí: `.env.example` sí se versiona, `.env*` no (ver .gitignore).

# ─── Base de datos (Supabase) ───────────────────────────────────────────────
# DATABASE_URL: conexión POOLED (pgbouncer) — la que usa la app en runtime.
# DIRECT_URL:   conexión DIRECTA — la que usan `prisma migrate` y el seed.
# El pooler de Supabase exige `uselibpqcompat=true` o falla con
# "self-signed certificate in certificate chain".
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:6543/postgres?pgbouncer=true&uselibpqcompat=true"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/postgres?uselibpqcompat=true"

# ─── Autenticación ──────────────────────────────────────────────────────────
# Secreto para firmar los JWT. Sin esto la autenticación no arranca.
# Generá uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Vigencia del token de sesión. Opcional, por defecto 24h.
SESSION_TIMEOUT="24h"

# ─── URLs públicas ──────────────────────────────────────────────────────────
# Base del sitio: se usa para armar el enlace de recuperación de contraseña.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Base de la API. Opcional, por defecto "/api" (mismo origen).
NEXT_PUBLIC_API_URL="/api"
