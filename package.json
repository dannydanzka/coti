{
  "name": "travel-savings-app",
  "version": "0.1.0",
  "description": "Herramienta de planificaci\u00f3n financiera para viajes \u2014 Next.js 16 + Clean Architecture (Soberan\u00eda del C\u00f3digo)",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.styled.ts",
    "**/*.styled.tsx",
    "src/libs/presentation/styles/GlobalStyles.tsx",
    "src/libs/presentation/providers/**/*.tsx"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "audit:dead": "knip --no-config-hints",
    "lint": "npm run lint:tsx && npm run lint:css && npm run type-check",
    "lint:tsx": "eslint . --config eslint.config.js --cache",
    "lint:css": "stylelint \"**/*.styled.{ts,tsx}\" --cache",
    "lint:fix": "npm run lint:tsx -- --fix && npm run lint:css -- --fix && npm run format",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "rm -rf .next out dist build .build-cache node_modules/.cache .eslintcache .stylelintcache .tsbuildinfo tsconfig.tsbuildinfo && echo '\u2713 Cache eliminado'",
    "kill": "lsof -ti :3000,3001,3002 | xargs kill -9 2>/dev/null; pkill -f 'next-server|next dev|node.*next' 2>/dev/null; echo '\u2713 Procesos de desarrollo terminados'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "type-check:clean": "rm -rf .tsbuildinfo tsconfig.tsbuildinfo && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@dannydanzka/sovereignty-ui": "file:vendor/sovereignty-ui",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "7",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.2",
    "i18next": "^25.8.14",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.544.0",
    "next": "^16.1.1",
    "pg": "^8.16.3",
    "prisma": "7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.70.0",
    "react-i18next": "^16.5.4",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "resend": "^6.2.2",
    "styled-components": "6.1.14",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^16.1.1",
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.5.7",
    "@swc/helpers": "^0.5.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/eslint-plugin": "^1.6.13",
    "babel-plugin-styled-components": "^2.1.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-testing-library": "^6.3.0",
    "eslint-restricted-globals": "^0.2.0",
    "globals": "^15.15.0",
    "jsdom": "^27.4.0",
    "knip": "^6.27.0",
    "postcss": "^8.4.47",
    "postcss-styled-syntax": "^0.7.1",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "stylelint": "^16.21.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-order": "^7.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}